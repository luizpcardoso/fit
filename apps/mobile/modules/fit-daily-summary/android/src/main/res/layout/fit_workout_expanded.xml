<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/workout_identity" android:layout_width="match_parent" android:layout_height="24dp" android:textStyle="bold" android:textSize="13sp" android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
      <TextView android:id="@+id/workout_exercise" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>
      <TextView android:id="@+id/workout_series" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tempo total" android:textSize="12sp" android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"/>
      <Chronometer android:id="@+id/workout_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:contentDescription="Tempo total do treino"/>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/workout_rest_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descanso: " android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"/>
    <Chronometer android:id="@+id/workout_rest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" android:contentDescription="Tempo de descanso"/>
  </LinearLayout>
  <Button android:id="@+id/workout_complete_series" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="48dp" android:text="Concluir série" android:textSize="14sp" android:textAllCaps="false"/>
</LinearLayout>
